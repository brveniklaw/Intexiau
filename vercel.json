{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "intexiau.com"
        }
      ],
      "destination": "https://www.intexiau.com/$1",
      "permanent": true
    },
    {
      "source": "/institute",
      "destination": "https://institute.intexiau.com",
      "permanent": true
    },
    {
      "source": "/institute/(.*)",
      "destination": "https://institute.intexiau.com/$1",
      "permanent": true
    }
  ]
}
