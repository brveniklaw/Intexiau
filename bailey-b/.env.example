# Copy to .env and fill in. Never commit .env.
# Nested settings use a double underscore.

BAILEY_CORPUS__DATA_DIR=data
BAILEY_CORPUS__STATUTES_YEAR=2026

# Free Law Project LSO Group Membership token (300 calls/day).
BAILEY_COURTLISTENER__API_TOKEN=
# LegiScan free tier key (10,000 queries/month), for interim statute amendments.
BAILEY_LEGISCAN__API_KEY=

BAILEY_EMBED__MODEL=BAAI/bge-m3
BAILEY_EMBED__DEVICE=cpu

# pgvector (default; Supabase in production) or qdrant
BAILEY_VECTOR_STORE__BACKEND=pgvector
# Local: docker compose --profile pgvector. Production: the BALS Supabase
# connection string (Project Settings > Database), with ?sslmode=require.
BAILEY_VECTOR_STORE__POSTGRES_DSN=postgresql://bailey:bailey@localhost:5432/bailey_b
BAILEY_VECTOR_STORE__QDRANT_URL=http://localhost:6333

BAILEY_SEARCH__TOP_K=20
BAILEY_SEARCH__TOP_N=5
